<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<ProxyEndpoint name="default">
  <FaultRules/>
  <PreFlow name="PreFlow">
    <Request>
      <Step>
        <Name>CORS-Allow</Name>
      </Step>
      <Step>
        <Name>EV-MCP-Tool</Name>
        <Condition>request.verb = "POST"</Condition>
      </Step>
      <Step>
        <Name>VA-VerifyAPIKey</Name>
        <!-- <Condition>request.verb != "OPTIONS" and mcp.tool != null</Condition> -->
      </Step>
      <Step>
        <Name>DC-MCP-Tool</Name>
        <Condition>mcp.tool != null</Condition>
      </Step>
      <Step>
        <Name>JS-Authz-Tool</Name>
        <Condition>request.verb != "OPTIONS" and mcp.method = "tools/call"</Condition>
      </Step>
      <Step>
        <Name>RF-Reject-Tool</Name>
        <Condition>request.verb != "OPTIONS" and mcp.method = "tools/call" and toolAuthorized = "false"</Condition>
      </Step>
      <Step>
        <Condition>request.verb != "OPTIONS" and mcp.method = "tools/call"</Condition>
        <Name>JS-MCP-Tool-Quota</Name>
      </Step>
      <Step>
        <Condition>request.verb != "OPTIONS" and mcp.method = "tools/call" and mcp.toolquotaenforce = "enabled"</Condition>
        <Name>Q-MCP-Tool-Quota</Name>
      </Step>
      <Step>
        <Name>SUP-ModelArmorCheck</Name>
        <Condition>mcp.method = "tools/call"</Condition>
      </Step>
    </Request>
    <Response/>
  </PreFlow>
  <EventFlow name="EventFlow" content-type="text/event-stream">
    <Response/>
  </EventFlow>
  <Flows/>
  <PostFlow name="PostFlow">
    <Request/>
    <Response/>
  </PostFlow>
  <PostClientFlow>
    <Description>Log to GCP Logging</Description>
    <Response>
      <Step>
        <Name>ML-LogToCloud</Name>
      </Step>
    </Response>
  </PostClientFlow>
  <HTTPProxyConnection>
    <BasePath>/test/mcp</BasePath>
    <Properties/>
  </HTTPProxyConnection>
  <RouteRule name="default">
    <TargetEndpoint>default</TargetEndpoint>
  </RouteRule>
</ProxyEndpoint>
