<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<TargetEndpoint name="default">
  <FaultRules/>
  <PreFlow name="PreFlow">
    <Request/>
    <Response>
      <Step>
        <Name>JS-Filter-Tools-NS</Name>
        <Condition>mcp.method = "tools/list"</Condition>
      </Step>
      <Step>
        <Name>JS-FlattenStructuredContent</Name>
        <Condition>mcp.method = "tools/call"</Condition>
      </Step>
      <Step>
        <Name>SMR-ModelArmorCheck</Name>
        <Condition>mcp.method = "tools/call"</Condition>
      </Step>
    </Response>
  </PreFlow>
  <EventFlow name="EventFlow" content-type="text/event-stream">
    <Response>
      <Step>
        <Name>JS-Filter-Tools</Name>
        <Condition>mcp.method = "tools/list"</Condition>
      </Step>
      <Step>
        <Name>JS-FlattenStructuredContent</Name>
        <Condition>mcp.method = "tools/call"</Condition>
      </Step>
      <Step>
        <Name>SMR-ModelArmorCheck</Name>
        <Condition>mcp.method = "tools/call"</Condition>
      </Step>
    </Response>
  </EventFlow>
  <Flows/>
  <PostFlow name="PostFlow">
    <Request/>
    <Response/>
  </PostFlow>
  <HTTPTargetConnection>
    <URL>https://{{REPLACE_ME}}/mcp</URL>
    <Properties/>
  </HTTPTargetConnection>
</TargetEndpoint>
